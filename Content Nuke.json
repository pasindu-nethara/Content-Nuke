      "parameters": {
        "jsCode": "// 1. Get the full text (Make sure 'text' matches your Gemini output field name)\n// It might be 'content', 'output', or 'text' depending on your node.\nconst fullText = $input.first().json.text; \n\n// 2. Split the text into an array based on your separator\nconst tweetsArray = fullText.split('|||').map(t => t.trim()).filter(t => t);\n\n// 3. Create a single object to hold them\nconst resultObject = {};\n\n// 4. Loop through and assign them to keys \"tweet 1\", \"tweet 2\", etc.\ntweetsArray.forEach((tweet, index) => {\n  resultObject[`tweet ${index + 1}`] = tweet;\n});\n\n// 5. Return as a single item\nreturn { json: resultObject };"
      },

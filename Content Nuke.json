      "parameters": {
        "jsCode": "// Get the content\nconst rawContent = $input.first().json.text; // Check that 'content' matches your Gemini output field name\n\n// Helper function to clean common JSON errors from LLMs\nfunction cleanJSON(str) {\n  // 1. Remove markdown code blocks if present\n  let clean = str.replace(/```json|```/g, '').trim();\n  \n  // 2. optional: replace \"smart quotes\" (curly quotes) which sometimes break things\n  clean = clean.replace(/[\\u201C\\u201D]/g, '\"');\n  \n  return clean;\n}\n\nlet parsedData;\ntry {\n  const cleanedText = cleanJSON(rawContent);\n  parsedData = JSON.parse(cleanedText);\n} catch (error) {\n  // If strict parsing fails, we return the error and the raw text so you don't lose the data\n  parsedData = { \n    error: \"JSON Parsing Failed - likely unescaped quotes\",\n    details: error.message,\n    fallback_raw_text: rawContent \n  };\n}\n\nreturn { json: parsedData };"
      },
